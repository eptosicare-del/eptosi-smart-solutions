# ============================================================
# EPTOSI SMART SOLUTIONS — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Resend Email ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── Admin Configuration ───────────────────────────────────────
ADMIN_EMAIL=admin@eptosismartsolutions.com
ADMIN_PASSWORD=your-strong-admin-password-here
ADMIN_JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://eptosismartsolutions.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ── reCAPTCHA (optional but recommended) ─────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
